{
	"name": "nextsim/nextsim-woo",
	"description": "Sell nextSIM eSIM plans on WooCommerce: import, automatic QR delivery, top-up and consumption checks.",
	"type": "wordpress-plugin",
	"license": "GPL-2.0-or-later",
	"require": {
		"php": ">=8.1",
		"bacon/bacon-qr-code": "^2.0"
	},
	"require-dev": {
		"phpunit/phpunit": "^11.0",
		"brain/monkey": "^2.6",
		"php-stubs/woocommerce-stubs": "^9.0",
		"php-stubs/wordpress-stubs": "^6.6"
	},
	"autoload-dev": {
		"psr-4": {
			"NextSIM\\Woo\\Tests\\": "tests/"
		}
	},
	"scripts": {
		"test": "phpunit"
	},
	"config": {
		"sort-packages": true
	}
}
